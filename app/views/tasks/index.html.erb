<div class="w-50 m-auto">
  <h1 class="text-center mb-5">My tasks</h1>

  <ul class="list-group">
    <% @tasks.each do |task| %>
      <li class='list-group-item'>
        <%= link_to task.title, task_path(task) %> <%= link_to "Delete", task_path(task), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
      </li>
    <% end %>
  </ul>

  <span class="btn">
    <%= link_to "Add a new task", new_path %>
  </span>
</div>
